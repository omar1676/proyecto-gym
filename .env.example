DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_de_cursos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Base que usan las pruebas. NUNCA la misma que DB_NAME: las suites borran filas
# para partir de un estado conocido. Se crea con php pruebas/preparar_base.php
DB_NAME_PRUEBAS=portal_de_cursos_pruebas

APP_ENV=development
APP_RELEASE=
APP_URL=http://localhost
APP_NOMBRE=Gimnasio

# Logo de la instalación: nombre del archivo dentro de public/assets/marca/.
# Vacío deja el icono genérico (la barra con discos).
APP_LOGO=

# Minutos de inactividad antes de cerrar sesión en el panel.
SESION_MINUTOS=120
# Opcional en producción; debe estar fuera de public/ y ser escribible por PHP.
SESSION_DIR=

# Zona horaria. Sin esto, la caja "del día" depende de cómo esté el servidor.
APP_ZONA_HORARIA=Europe/Madrid

# Correo saliente. MAIL_FROM tiene que ser una dirección del dominio propio o
# los avisos acabarán en spam. Con MAIL_SMTP_HOST relleno se envía por SMTP
# (recomendado en alojamiento compartido); vacío usa mail() del servidor.
MAIL_FROM=noreply@tu-dominio.es
MAIL_NOMBRE=
MAIL_SMTP_HOST=
MAIL_SMTP_PUERTO=587
MAIL_SMTP_USUARIO=
MAIL_SMTP_CLAVE=
MAIL_SMTP_SEGURIDAD=tls

# Copias de seguridad: dónde se dejan y cuántos días se guardan.
COPIAS_DIR=
# Directorio montado/sincronizado fuera del servidor. Vacío = copia externa pendiente.
COPIAS_EXTERNAS_DIR=
COPIAS_DIARIAS=7
COPIAS_SEMANALES=4
COPIAS_MENSUALES=6

# Copia físicamente externa mediante un remote cifrado de rclone. Permanece
# desactivada hasta crear /etc/gimnera/rclone.conf fuera de Git y probar restore.
BACKUP_EXTERNAL_ENABLED=false
BACKUP_EXTERNAL_REMOTE=
BACKUP_EXTERNAL_CONFIG=
BACKUP_EXTERNAL_ENCRYPTED=false
BACKUP_EXTERNAL_VERIFY_DIR=

# Logs fuera de public/. Producción: usuario web con escritura, código sin escritura.
LOG_DIR=
LOG_DIAS=30
LOG_MAX_BYTES=10485760
LOG_ERRORS_HORA_MAX=50
DISCO_LIBRE_MINIMO_PCT=15
MONITOR_URL=
MONITOR_STATE_DIR=
MONITOR_ALERT_COOLDOWN_MINUTES=60
MONITOR_ALERT_EMAIL=

# Staging temporal de importaciones, siempre fuera de public/.
IMPORT_DIR=
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=10000
IMPORT_RETENTION_DAYS=7

# Control de acceso: no conecta con hardware. La única implementación incluida
# es mock. Una instalación nueva siempre debe comenzar disabled y pasar primero
# por shadow. Active exige también ACCESS_CONTROL_ACTIVE_CONFIRM=true.
ACCESS_CONTROL_MODE=disabled
ACCESS_CONTROL_PROVIDER=mock
ACCESS_CONTROL_ACTIVE_CONFIRM=false
ACCESS_CONTROL_MAX_ATTEMPTS=5
ACCESS_CONTROL_BACKOFF_SECONDS=60

# Credenciales de prueba para rellenar los formularios de acceso durante el
# desarrollo. Déjalas vacías o borra las líneas: se ignoran salvo con
# APP_ENV=development, así que en el servidor no tienen ningún efecto.
DEV_GIMNASIO_EMAIL=
DEV_GIMNASIO_PASS=
DEV_USUARIO=
DEV_USUARIO_PASS=
