DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_de_cursos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Base que usan las pruebas. NUNCA la misma que DB_NAME: las suites borran filas
# para partir de un estado conocido. Se crea con php pruebas/preparar_base.php
DB_NAME_PRUEBAS=portal_de_cursos_pruebas

APP_ENV=development
APP_URL=http://localhost
APP_NOMBRE=Gimnasio

# Logo de la instalación: nombre del archivo dentro de public/assets/marca/.
# Vacío deja el icono genérico (la barra con discos).
APP_LOGO=

# Minutos de inactividad antes de cerrar sesión en el panel.
SESION_MINUTOS=120

# Zona horaria. Sin esto, la caja "del día" depende de cómo esté el servidor.
APP_ZONA_HORARIA=Europe/Madrid

# Correo saliente. MAIL_FROM tiene que ser una dirección del dominio propio o
# los avisos acabarán en spam. Con MAIL_SMTP_HOST relleno se envía por SMTP
# (recomendado en alojamiento compartido); vacío usa mail() del servidor.
MAIL_FROM=noreply@tu-dominio.es
MAIL_NOMBRE=
MAIL_SMTP_HOST=
MAIL_SMTP_PUERTO=587
MAIL_SMTP_USUARIO=
MAIL_SMTP_CLAVE=
MAIL_SMTP_SEGURIDAD=tls

# Copias de seguridad: dónde se dejan y cuántos días se guardan.
COPIAS_DIR=
COPIAS_DIAS=30

# Credenciales de prueba para rellenar los formularios de acceso durante el
# desarrollo. Déjalas vacías o borra las líneas: se ignoran salvo con
# APP_ENV=development, así que en el servidor no tienen ningún efecto.
DEV_GIMNASIO_EMAIL=
DEV_GIMNASIO_PASS=
DEV_USUARIO=
DEV_USUARIO_PASS=
