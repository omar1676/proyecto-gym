# Plantilla sin secretos. Copiar fuera de Git y completar en el servidor staging.
APP_ENV=staging
APP_URL=https://staging.example.invalid
APP_NOMBRE=Piloto Gimnasio — STAGING
APP_LOGO=
APP_ZONA_HORARIA=Europe/Madrid

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gimnasio_staging
DB_USER=staging_usuario_independiente
DB_PASS=CAMBIAR_FUERA_DE_GIT
DB_CHARSET=utf8mb4
DB_NAME_PRUEBAS=gimnasio_tests_independiente

SESION_MINUTOS=60
SESSION_DIR=/var/lib/gimnasio-staging/sessions
LOG_DIR=/var/log/gimnasio-staging
IMPORT_DIR=/var/lib/gimnasio-staging/imports
COPIAS_DIR=/var/backups/gimnasio-staging/local
# Debe ser almacenamiento físicamente separado; no otra carpeta del mismo disco.
COPIAS_EXTERNAS_DIR=/mnt/backup-externo/gimnasio-staging
COPIAS_DIARIAS=7
COPIAS_SEMANALES=4
COPIAS_MENSUALES=6
LOG_DIAS=30
LOG_MAX_BYTES=10485760
LOG_ERRORS_HORA_MAX=50
DISCO_LIBRE_MINIMO_PCT=15
MONITOR_URL=https://staging.example.invalid
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=10000
IMPORT_RETENTION_DAYS=7

# Staging nunca usa mail(). Sin SMTP o allowlist el correo queda bloqueado.
MAIL_FROM=noreply-staging@example.invalid
MAIL_NOMBRE=Piloto STAGING
MAIL_SMTP_HOST=
MAIL_SMTP_PUERTO=587
MAIL_SMTP_USUARIO=
MAIL_SMTP_CLAVE=
MAIL_SMTP_SEGURIDAD=tls
STAGING_MAIL_ALLOWLIST=

# Forzado también en código a disabled cuando APP_ENV=staging.
ACCESS_CONTROL_MODE=disabled
ACCESS_CONTROL_PROVIDER=mock
ACCESS_CONTROL_ACTIVE_CONFIRM=false
ACCESS_CONTROL_MAX_ATTEMPTS=5
ACCESS_CONTROL_BACKOFF_SECONDS=60
