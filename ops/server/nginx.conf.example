server {
    listen 80;
    server_name gimnasio.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name gimnasio.example.com;
    root /var/www/gimnasio/current/public;
    index index.php;
    client_max_body_size 3m;
    location ^~ /assets/fotos/ { return 404; }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /health { try_files $uri /index.php?action=health; }
    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
    location ~* ^/assets/.*\.(php[0-9]?|phtml|phar)$ { deny all; }
    location ~ /\. { deny all; }
}
