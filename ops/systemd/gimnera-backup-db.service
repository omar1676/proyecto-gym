[Unit]
Description=Gimnera - backup consistente de MariaDB
After=mariadb.service
Requires=mariadb.service
ConditionPathExists=/var/www/gimnasio/current/.env

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/gimnasio/current
ExecStart=/usr/bin/flock -w 1800 /var/www/gimnasio/shared/.backup-operation.lock /usr/bin/php /var/www/gimnasio/current/cron/copia_seguridad.php
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www/gimnasio/shared
CapabilityBoundingSet=
